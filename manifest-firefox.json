{
    "manifest_version": 2,
    "name": "__MSG_appName__",
    "version": "1.4.0",
    "description": "__MSG_appDesc__",
    "author": "TimeConvert",
    "default_locale": "en",
    "permissions": [
        "storage",
        "scripting",
        "contextMenus",
        "<all_urls>"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "timezone-converter@example.com",
            "strict_min_version": "140.0",
            "update_url": "https://github.com/dZarkX/TimeConvert/releases/latest",
            "data_collection_permissions": {
                "required": [
                    "none"
                ],
                "optional": []
            }
        },
        "gecko_android": {
            "id": "timezone-converter@example.com",
            "strict_min_version": "142.0",
            "update_url": "https://github.com/dZarkX/TimeConvert/releases/latest",
            "data_collection_permissions": {
                "required": [
                    "none"
                ],
                "optional": []
            }
        }
    },
    "background": {
        "scripts": ["src/scripts/background.js"],
        "persistent": false
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "all_frames": true,
            "match_about_blank": true,
            "js": ["src/scripts/content.js"],
            "css": ["src/styles/highlight.css"],
            "run_at": "document_idle"
        }
    ],
    "options_page": "src/pages/settings.html",
    "web_accessible_resources": [
        "src/styles/*",
        "src/icons/*"
    ],
    "browser_action": {
        "default_popup": "src/pages/popup.html",
        "default_icon": {
            "16": "src/icons/icon16.png",
            "32": "src/icons/icon32.png",
            "48": "src/icons/icon48.png",
            "128": "src/icons/icon128.png"
        },
        "default_title": "__MSG_appName__"
    },
    "icons": {
        "16": "src/icons/icon16.png",
        "32": "src/icons/icon32.png",
        "48": "src/icons/icon48.png",
        "128": "src/icons/icon128.png"
    }
}
